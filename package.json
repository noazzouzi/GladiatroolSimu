{
  "name": "gladiatrool-simu",
  "version": "0.1.0",
  "private": true,
  "description": "Simulateur du Gladiatrool (DOFUS) : moteur de combat fidèle et planificateur d'actions",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:data": "python3 tools/simdata/build_sim_data.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "tsx sim/src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
