{
  "name": "gladiatrool-simu",
  "version": "0.1.0",
  "private": true,
  "description": "Simulateur du Gladiatrool (DOFUS) : moteur de combat fidèle et planificateur d'actions",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:data": "python3 tools/simdata/build_sim_data.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "cli": "tsx sim/src/cli/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
